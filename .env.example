# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
POSTGRES_DB=speech_erp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- CORS (the Next.js frontend) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Business rules (see docs/00-OVERVIEW.md) ---
# Expenses at or above this need Admin approval; below, auto-approved.
EXPENSE_AUTO_APPROVE_THRESHOLD=5000
# Day of month a monthly bill falls due.
MONTHLY_BILL_DUE_DAY=5
# Age below which guardian details are required on patient registration.
PATIENT_MINOR_AGE=18
# Online booking advance = this fraction of the service fee (docs/05).
BOOKING_ADVANCE_RATIO=0.5
# Bookable hours, inclusive at both ends.
BOOKING_WINDOW_START_HOUR=10
BOOKING_WINDOW_END_HOUR=18

# --- Cloudinary (material images, docs/06-materials.md) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Sentry (production only; leave blank in development) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Reminders (SMS/WhatsApp via Twilio, email) — apps/notifications ---
# Status: built, pending final confirmation with the client on whether it
# ships. Leave blank to no-op (logs what would have been sent instead).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
DEFAULT_FROM_EMAIL=no-reply@speechlab.test
# Production only — leave unset to log reminder emails instead of sending.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
